# Formal 01 quantizer-fair defaults for SAQ 4-bit reproduction.
# Dataset selection is intentionally not defined here.
# Pass DATASETS explicitly at runtime, e.g. DATASETS="dbpedia gist agnews".
PYTHON_BIN="${PYTHON_BIN:-python3}"

B="${B:-4}"
K="${K:-4096}"
BUILD_THREADS="${BUILD_THREADS:-64}"
QUERY_THREADS="${QUERY_THREADS:-1}"
FIX_NPROBE="${FIX_NPROBE:-0}"
SEARCHER_VARS_BOUND_M="${SEARCHER_VARS_BOUND_M:-4}"

RUN_PREP="${RUN_PREP:-1}"
RUN_CREATE_INDEX="${RUN_CREATE_INDEX:-1}"
RUN_ACCURACY="${RUN_ACCURACY:-1}"
RUN_QPS="${RUN_QPS:-1}"
